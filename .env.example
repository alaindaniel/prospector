# Configurações de Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados SQLite
DB_PATH=./data/prospector.sqlite

# Provedor de IA (deterministic | openai_compatible)
AI_PROVIDER=deterministic
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# Provedores Externos (Fase 1: desativados / sandbox seguro)
EMAIL_PROVIDER=sandbox
WHATSAPP_PROVIDER=sandbox
COMPANY_DATA_PROVIDER=local_catalog

# Segurança
APP_SECRET_SALT=change-this-in-production-via-env
