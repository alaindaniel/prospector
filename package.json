{
  "name": "prospector-ia",
  "version": "1.0.0",
  "description": "Plataforma estruturada de prospecção B2B, auditoria digital, diagnóstico por IA, aprovação humana e CRM em pipeline.",
  "main": "dist/backend/server.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('public', {recursive:true}); ['index.html','styles.css','app.js','client-backend.js'].forEach(f=>fs.copyFileSync(f, 'public/'+f));\"",
    "start": "node dist/backend/server.js",
    "dev": "tsc && node dist/backend/server.js",
    "seed": "tsc && node dist/database/seed.js",
    "test": "tsc && node --test dist/tests/*.test.js"
  },
  "keywords": [
    "prospector",
    "crm",
    "ai-audit",
    "b2b",
    "lead-scoring"
  ],
  "author": "Prospector IA",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
